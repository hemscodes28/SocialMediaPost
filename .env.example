# Copy to .env in this folder (SocialMediaAutomation/) OR the parent repo folder (Social_media2/).
# The app loads both locations; app-folder .env overrides parent if both exist.

# --- Production hosting (required when not using localhost) ---
# No trailing slash. OAuth callbacks are built from this URL automatically.
APP_PUBLIC_URL=https://social.dmprojects.in

# Google Sign-In (OAuth 2.0 Client ID — Web application, optional legacy GIS)
GOOGLE_CLIENT_ID=

# Firebase Auth (must match your Firebase web app project)
FIREBASE_PROJECT_ID=smauto-10c96
FIREBASE_WEB_API_KEY=AIzaSyCuEgLqq1k8xBGHCKasFaYwPbcd44O7FGo

# Instagram API Configuration
INSTAGRAM_ACCOUNT_ID=
PAGE_ACCESS_TOKEN=

# Facebook App Credentials (for token refresh)
FB_APP_ID=
FB_APP_SECRET=
# Optional overrides (if APP_PUBLIC_URL is set, these are ignored unless you unset APP_PUBLIC_URL)
FB_REDIRECT_URI=https://social.dmprojects.in/api/platforms/facebook/callback

# Image Hosting
IMGBB_API_KEY=
IMGUR_CLIENT_ID=
CATBOX_USER_HASH=

# Ollama AI Content Generation
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# LinkedIn API (for posting to LinkedIn)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_REDIRECT_URI=https://social.dmprojects.in/api/platforms/linkedin/callback

# API Settings
GRAPH_API_VERSION=v24.0
MAX_FILE_SIZE_MB=10
HOST=0.0.0.0
PORT=8000
